R23 _net49 VOUT_FILTER_SW  1.59K tc1=0.0 tc2=0.0 
R24 _net47 _net49  1.59K tc1=0.0 tc2=0.0 
V31 VIN_SW 0 DC 0 SIN(0 {VINAMP} 1K 0 0 0) AC {VINAMP} ACPHASE 0
V32 _net50 0 DC 5
R25 VOUT_FILTER_SW VOUT_NORM  1K tc1=0.0 tc2=0.0 
D1 0 VOUT_NORM DMOD_D1 AREA=1.0
.MODEL DMOD_D1 D (Is=1E-15 N=1 Cj0=10F M=0.5 Vj=0.7 Fc=0.5 Rs=0.0 Tt=0.0P Kf=0.0 Af=1.0 Bv=10 Ibv=1M Xti=3.0 Eg=1.11 Tcv=0.0 Trs=0.0 Ttt1=0.0 Ttt2=0.0 Tm1=0.0 Tm2=0.0 Tnom=26.85 )
D2 VOUT_NORM 0 DMOD_D2 AREA=1.0
.MODEL DMOD_D2 D (Is=1E-15 N=1 Cj0=10F M=0.5 Vj=0.7 Fc=0.5 Rs=0.0 Tt=0.0P Kf=0.0 Af=1.0 Bv=10 Ibv=1M Xti=3.0 Eg=1.11 Tcv=0.0 Trs=0.0 Ttt1=0.0 Ttt2=0.0 Tm1=0.0 Tm2=0.0 Tnom=26.85 )

.control

ac dec 40 1 100k 
write spice4qucs.ac1.plot v(VIN) v(VIN_SW) v(VIN_TRAN) v(VOUT_FILTER) v(VOUT_FILTER_SW) v(VOUT_FILTER_TRAN) v(VOUT_HP) v(VOUT_HP_2) v(VOUT_LP) v(VOUT_NORM)
destroy all
reset

option interp
let number_vinamp = 0
echo "STEP tr1.vinamp" > spice4qucs.tr1.cir.res
foreach  vinamp_act 0.1 0.357895 0.615789 0.873684 1.13158 1.38947 1.64737 1.90526 2.16316 2.42105 2.67895 2.93684 3.19474 3.45263 3.71053 3.96842 4.22632 4.48421 4.74211 5 
alterparam VinAmp = $vinamp_act
reset
tran 5e-06 0.1 0 
write spice4qucs.tr1._swp.plot v(VIN) v(VIN_SW) v(VIN_TRAN) v(VOUT_FILTER) v(VOUT_FILTER_SW) v(VOUT_FILTER_TRAN) v(VOUT_HP) v(VOUT_HP_2) v(VOUT_LP) v(VOUT_NORM)
set appendwrite
echo "$&number_vinamp  $vinamp_act" >> spice4qucs.tr1.cir.res
let number_vinamp = number_vinamp + 1
end
unset appendwrite
destroy all
reset

exit
.endc
.END
