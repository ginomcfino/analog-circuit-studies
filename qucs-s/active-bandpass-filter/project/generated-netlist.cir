VLIM  7  8 DC 0
VLP  91  0 DC 40
VLN   0 92 DC 40
.MODEL DX D(IS=800.0E-18)
.MODEL QX PNP(IS=800.0E-18 BF=250)
.ENDS 
  
.PARAM VinAmp = 1
XOP1 0 0 _net0 _net1 _net2 VOUT_HP SpiceOpamp_LM324
V2 _net1 0 DC 5
V1 0 _net2 DC 5
R2 _net3 _net0  15.9K tc1=0.0 tc2=0.0 
C1 VIN _net3  100N 
R1 _net0 VOUT_HP  15.9K tc1=0.0 tc2=0.0 
